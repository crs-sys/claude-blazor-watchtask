{
  "name": "MyApp",
  "repoRoot": ".",
  "server": { "port": 43617 },
  "build": {
    "command": "dotnet",
    "args": ["build", "src/MyApp/MyApp.csproj", "-v", "q", "--nologo"],
    "workingDir": "."
  },
  "preBuildSteps": [
    {
      "name": "tailwind",
      "command": "npx",
      "args": ["@tailwindcss/cli", "-i", "./tailwind.input.css", "-o", "./wwwroot/css/app.css", "--minify"],
      "workingDir": "src/MyApp",
      "when": ["**/*.razor", "**/*.html", "src/MyApp/tailwind.input.css"],
      "output": "src/MyApp/wwwroot/css/app.css",
      "route": "css/app.css",
      "timeoutSec": 120
    }
  ],
  "run": {
    "command": "dotnet",
    "args": ["run", "--project", "src/MyApp", "--no-build"],
    "workingDir": ".",
    "env": {
      "ASPNETCORE_ENVIRONMENT": "Development"
    },
    "inheritEnv": true,
    "readiness": {
      "stdoutRegex": "Now listening on:|Application is running",
      "probeUrl": "https://localhost:5001",
      "timeoutSec": 60
    },
    "appUrl": "https://localhost:5001",
    "killOrphansOnPorts": [5001, 5000]
  },
  "classify": {
    "exclude": [
      "**/App_Data/**",
      "**/bin/**",
      "**/obj/**",
      "**/node_modules/**",
      "src/MyApp/wwwroot/css/app.css",
      "publish/**",
      ".claude/**",
      "**/*.md"
    ],
    "cssOnly": ["src/MyApp/tailwind.input.css"],
    "cssFastPath": true
  },
  "browserReload": { "enabled": true },
  "fallbackWatch": {
    "enabled": true,
    "mode": "hybrid",
    "paths": ["src"],
    "quietPeriodSec": 1,
    "agentIdleTimeoutSec": 180
  }
}
