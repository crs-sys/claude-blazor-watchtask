{
  "name": "SraServiceStack",
  "repoRoot": "C:\\Users\\chris\\Projects\\SraServiceStack",
  "server": { "port": 43617 },
  "build": {
    "command": "dotnet",
    "args": ["build", "Sra/Sra.csproj", "-v", "q", "--nologo", "--no-restore", "-p:RunAnalyzers=false"],
    "workingDir": ".",
    "env": { "DOTNET_CLI_USE_MSBUILD_SERVER": "1" }
  },
  "preBuildSteps": [
    {
      "name": "tailwind",
      "command": "node",
      "args": ["node_modules/@tailwindcss/cli/dist/index.mjs", "-i", "./tailwind.input.css", "-o", "./wwwroot/css/app.css", "--minify"],
      "workingDir": "Sra",
      "when": ["**/*.razor", "**/*.html", "Sra/tailwind.input.css", "Sra/tailwind.config.js"],
      "output": "Sra/wwwroot/css/app.css",
      "route": "css/app.css",
      "timeoutSec": 120
    }
  ],
  "run": {
    "command": "bin/Debug/net10.0/Sra.exe",
    "args": [],
    "workingDir": "Sra",
    "env": {
      "ASPNETCORE_ENVIRONMENT": "Development",
      "ASPNETCORE_URLS": "https://localhost:5001;http://localhost:5000"
    },
    "inheritEnv": true,
    "requiredEnv": ["SERVICESTACK_LICENSE"],
    "readiness": {
      "stdoutRegex": "Now listening on:|Application is running",
      "probeUrl": "https://localhost:5001",
      "timeoutSec": 60
    },
    "appUrl": "https://localhost:5001",
    "killOrphansOnPorts": [5001, 5000]
  },
  "classify": {
    "exclude": [
      "**/App_Data/**",
      "**/bin/**",
      "**/obj/**",
      "**/node_modules/**",
      "Sra/wwwroot/css/app.css",
      "publish/**",
      "**/.playwright-*/**",
      ".claude/**",
      "**/*.md",
      "agile-artifacts/**",
      "docs/**"
    ],
    "cssOnly": ["Sra/tailwind.input.css", "Sra/tailwind.config.js"],
    "cssFastPath": true
  },
  "browserReload": { "enabled": true },
  "fallbackWatch": {
    "enabled": true,
    "mode": "hybrid",
    "paths": ["Sra", "Sra.ServiceModel", "Sra.ServiceInterface", "Sra.Data", "Sra.BrIO", "external"],
    "quietPeriodSec": 1,
    "agentIdleTimeoutSec": 180
  }
}
