<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ClaudeWatch</RootNamespace>
    <AssemblyName>claude-watch</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>claude-watch</ToolCommandName>
    <PackageId>ClaudeWatch</PackageId>
    <Version>0.1.0</Version>
    <Description>Claude Code-aware alternative to dotnet watch: rebuilds and restarts a .NET web app once per round of Claude edits, then reloads the browser.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RollForward>LatestMajor</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\**" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
